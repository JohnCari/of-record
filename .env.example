# Copy to .env.local and fill in. Never commit real values.
AI_GATEWAY_API_KEY=      # Vercel AI Gateway key. One key serves the drafter (google/gemini-3.8-flash) and the judge (typesafe-ai/jev)
COURTLISTENER_TOKEN=     # free, https://www.courtlistener.com/help/api/rest/ ; needed for opinion text and citation lookup
INVITE_SECRET=           # openssl rand -hex 24 ; signs the invite cookie
SERVER_SECRET=           # openssl rand -hex 24 ; also set on Convex: pnpm exec convex env set SERVER_SECRET <value>
NEXT_PUBLIC_CONVEX_URL=  # written by `convex dev`
